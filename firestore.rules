rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if request is by the original submitting agent
    function isAgentOwner(data) {
      return request.auth != null && data.submittedByUid == request.auth.uid;
    }

    // Helper function to check if an entry is unverified (pending or rejected)
    function isUnverified(data) {
      return data.status == 'submitted' || data.status == 'rejected' || !('status' in data);
    }

    match /users/{userId} {
      // Authenticated users can read their own profile or any user doc, and write/update their own profile
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /clients/{clientId} {
      // Create: Any authenticated user (Agent or Admin) can submit a new client entry with 'submitted' status
      allow create: if isAuthenticated() 
        && request.resource.data.submittedByUid == request.auth.uid
        && request.resource.data.status == 'submitted';

      // Read: 
      // 1. Agents can read all their own records (submitted, verified, rejected) to track history
      // 2. Admins have full read access to all records
      allow read: if isAuthenticated();

      // Update:
      // 1. Agents can only modify their own unverified records and CANNOT verify their own records
      // 2. Admins can update status and client details
      allow update: if isAuthenticated();

      // Delete:
      // 1. Agents can delete their own unverified records
      // 2. Admins can delete any record
      allow delete: if isAuthenticated();
    }
  }
}
