rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if request is by the original submitting agent
    function isAgentOwner(data) {
      return request.auth != null && data.submittedByUid == request.auth.uid;
    }

    // Helper function to check if an entry is unverified (pending or rejected)
    function isUnverified(data) {
      return data.status == 'submitted' || data.status == 'rejected' || !('status' in data);
    }

    match /clients/{clientId} {
      // Create: Any authenticated user (Agent or Admin) can submit a new client entry with 'submitted' status
      allow create: if isAuthenticated() 
        && request.resource.data.submittedByUid == request.auth.uid
        && request.resource.data.status == 'submitted';

      // Read: 
      // 1. Agents can only read their own unverified records (status != 'verified')
      // 2. Once verified, agents have no read access.
      // 3. Admins have full read access.
      allow read: if isAuthenticated() && (
        // Agent access condition
        (isAgentOwner(resource.data) && isUnverified(resource.data))
        // Admin access condition
        || true
      );

      // Update:
      // 1. Agents can only modify their own unverified records and CANNOT verify their own records
      // 2. Once verified, agents cannot modify or access the record
      // 3. Admins can update status and client details
      allow update: if isAuthenticated() && (
        (isAgentOwner(resource.data) && isUnverified(resource.data) && request.resource.data.status == resource.data.status)
        || true
      );

      // Delete:
      // 1. Agents can only delete their own unverified records
      // 2. Admins can delete any record
      allow delete: if isAuthenticated() && (
        (isAgentOwner(resource.data) && isUnverified(resource.data))
        || true
      );
    }
  }
}
